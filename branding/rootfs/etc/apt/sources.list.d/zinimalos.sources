# ZinimalOS — aggiornamenti del progetto (pacchetto zinimalos-branding).
#
# Installato dal pacchetto stesso: non serve Aggiungerlo a mano sulle macchine
# già aggiornate con una ISO recente. Il repository è firmato: apt verifica la
# Release con la chiave pubblica in /etc/apt/keyrings/zinimalos.gpg.
#
#   sudo apt update && sudo apt upgrade
#
# Formato deb822 (apt ≥ 2.x). Documentazione: docs/UPDATES.md

Types: deb
URIs: https://avancerdev.github.io/zinimalos-repo/
Suites: trixie
Components: main
Architectures: amd64
Signed-By: /etc/apt/keyrings/zinimalos.gpg
