#!/bin/sh
# made-by — crediti del progetto LiveDeb13.
#
# Uso:
#   made-by        crediti completi
#   made by        (scorciatoia: /usr/local/bin/made passa qui)
#   made
#
# I metadati arrivano da /etc/livedeb13-release: per cambiarli basta modificare
# quel file (o il sorgente config/includes.chroot/etc/livedeb13-release).

set -eu

if [ -r /etc/livedeb13-release ]; then
    . /etc/livedeb13-release
fi

PROJECT=${LIVEDEB13_PROJECT:-LiveDeb13}
CREATOR=${LIVEDEB13_CREATOR:-AvancerDev}
URL=${LIVEDEB13_URL:-https://github.com/AvancerDev/LiveDeb13}
TAGLINE=${LIVEDEB13_TAGLINE:-Debian 13 (trixie) — live + installer}
VERSION=${LIVEDEB13_VERSION:-dev}

# Colori solo su terminale (rispetta NO_COLOR: https://no-color.org)
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B=$(printf '\033[1m')
    C=$(printf '\033[1;36m')
    Y=$(printf '\033[1;33m')
    D=$(printf '\033[2m')
    N=$(printf '\033[0m')
else
    B='' C='' Y='' D='' N=''
fi

printf '\n'
printf '  %s%s%s%s\n' "$C" "$B" "$PROJECT" "$N"
printf '  %s%s%s\n' "$D" "$TAGLINE" "$N"
printf '\n'
printf '  %s%-11s%s %s%s%s\n'   "$D" "Creato da"  "$N" "$Y" "$CREATOR" "$N"
printf '  %s%-11s%s %s\n'       "$D" "Progetto"   "$N" "$PROJECT"
printf '  %s%-11s%s %s\n'       "$D" "Repository" "$N" "$URL"
printf '  %s%-11s%s %s\n'       "$D" "Versione"   "$N" "$VERSION"
printf '\n'
printf '  %s%s%s\n' "$D" "Realizzato con Debian GNU/Linux e live-build. Debian è un marchio dei rispettivi proprietari." "$N"
printf '\n'
