#!/bin/sh
# ZinimalOS — mostra informazioni sul sistema live
set -eu
echo "=== ZinimalOS — Debian 13 (trixie) Minimal ==="
echo "Hostname:  $(hostname)"
echo "Kernel:    $(uname -r)"
echo "Arch:      $(uname -m)"
echo "OS:        $(cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"')"
echo "Memoria:   $(free -h | awk '/Mem:/ {print $2}')"
echo "Disco:     $(df -h / | awk 'NR==2 {print $4\" liberi su \"$2}')"
echo "Utente:    $(whoami)"
echo ""
echo "Comandi utili:"
echo "  zinimalos-install   Avvia Debian Installer"
echo "  made by             Crediti del progetto (AvancerDev / ZinimalOS)"
echo "  fastfetch           Banner con logo e info di sistema"
echo "  sudo apt update     Aggiorna i pacchetti (live)"
echo "  lsblk               Dischi e partizioni"
