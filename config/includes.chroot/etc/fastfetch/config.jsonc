// ZinimalOS — configurazione di fastfetch.
// File: /etc/fastfetch/config.jsonc
//
// Il logo del sistema è il file ASCII /usr/share/zinimalos/logo-ascii.txt:
// viene mostrato a sinistra delle info quando esegui `fastfetch`.
// All'accesso NON viene eseguito automaticamente: si vede soltanto il MOTD
// (/etc/motd) e, prima del login, il logo piccolo di /etc/issue.
//
// Moduli e sintassi: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/zinimalos/logo-ascii.txt"
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "custom",
      "format": "\u001b[1;36mZinimalOS\u001b[0m — Debian 13 (trixie), live + installer"
    },
    {
      "type": "custom",
      "format": "Made by \u001b[1;33mAvancerDev\u001b[0m \u001b[2m(`made by` per i crediti)\u001b[0m"
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
