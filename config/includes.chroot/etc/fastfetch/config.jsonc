// LiveDeb13 — configurazione fastfetch, mostrata all'accesso sulla console.
// File: /etc/fastfetch/config.jsonc
// Moduli e sintassi: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " : "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "custom",
      "format": "\u001b[1;36mLiveDeb13\u001b[0m — Debian 13 (trixie), live + installer"
    },
    {
      "type": "custom",
      "format": "Made by \u001b[1;33mAvancerDev\u001b[0m \u001b[2m(`made by` per i crediti)\u001b[0m"
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
