// ZinimalOS — configurazione di fastfetch.
// File: /etc/fastfetch/config.jsonc
//
// - Il logo viene da /usr/share/zinimalos/logo-ascii.txt (ASCII puro: si vede
//   su qualsiasi font di console, senza caratteri "strani").
// - "color": { "1": "white" } rende il logo BIANCO: i placeholder $1 del file
//   vengono sostituiti con questo colore.
// - fastfetch NON parte da solo all'accesso: lo esegui solo tu.
//
// Moduli e sintassi: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/zinimalos/logo-ascii.txt",
    "color": {
      "1": "white"
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "custom",
      "format": "\u001b[1;36mZinimalOS\u001b[0m — Debian 13 (trixie), live + installer"
    },
    {
      "type": "custom",
      "format": "Made by \u001b[1;33mAvancerDev\u001b[0m \u001b[2m(`made by` per i crediti)\u001b[0m"
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
