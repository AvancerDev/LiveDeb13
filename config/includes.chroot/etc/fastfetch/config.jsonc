// ZinimalOS — configurazione fastfetch, mostrata all'accesso sulla console.
// File: /etc/fastfetch/config.jsonc
// Il logo ASCII del sistema lo stampa /etc/profile.d/00-zinimalos-welcome.sh
// (a colori), quindi qui il logo di fastfetch è disattivato.
// Moduli e sintassi: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "custom",
      "format": "\u001b[1;36mZinimalOS\u001b[0m — Debian 13 (trixie), live + installer"
    },
    {
      "type": "custom",
      "format": "Made by \u001b[1;33mAvancerDev\u001b[0m \u001b[2m(`made by` per i crediti)\u001b[0m"
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
