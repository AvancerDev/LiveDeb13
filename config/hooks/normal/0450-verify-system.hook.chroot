#!/bin/sh
# ZinimalOS — ripara e verifica il sistema prima di creare lo squashfs.
#
# Intercetta difetti che altrimenti si scoprono solo avviando la live, dove
# costano un'altra build:
#
#   sudo: /usr/bin/sudo is owned by uid 1000, should be 0
#   sudo: setuid must be root-owned and setuid bit set
#   apt:  open (13: Permission denied)
#   user: /home/user: change directory failed: Permission denied
#
# Perché serve un hook e non basta riparare prima di `lb build`: live-build
# salva il chroot in cache/chroot e lo RIpristina all'inizio dello stadio
# chroot. Questo hook gira DOPO il ripristino e PRIMA del salvataggio, quindi
# il sistema che finisce nell'ISO e il cache salvato sono entrambi puliti.
#
# La riparazione è SEMPRE eseguita (non solo quando trova qualcosa di strano):
# `chown` azzera i bit setuid/setgid, quindi un chroot già "di root" può
# comunque avere sudo senza setuid — è esattamente il caso della build
# 2026-11-24 18:18 (`ERRORE: /usr/bin/sudo non ha il bit setuid`).

set -eu

fail=0
error() { echo "ERRORE: $*" >&2; fail=1; }

# --- Permessi canonici dei binari privilegiati di Debian (mode:path) --------
# `chown` li azzera: qui li rimettiamo come li consegna dpkg.
PRIV_BINS="4755:/usr/bin/sudo
4755:/usr/bin/su
4755:/usr/bin/passwd
4755:/usr/bin/chsh
4755:/usr/bin/chfn
4755:/usr/bin/newgrp
4755:/usr/bin/gpasswd
4755:/usr/bin/mount
4755:/usr/bin/umount
4755:/usr/bin/fusermount3
4755:/usr/lib/openssh/ssh-keysign
4755:/usr/libexec/polkit-agent-helper-1
4754:/usr/lib/dbus-1.0/dbus-daemon-launch-helper
2755:/usr/lib/x86_64-linux-gnu/utempter/utempter"

restore_privileged_bits() {
  printf '%s\n' "$PRIV_BINS" | while IFS=: read -r mode path; do
    [ -e "$path" ] || continue
    chmod "$mode" "$path" 2>/dev/null || true
  done
  [ -e /usr/lib/dbus-1.0/dbus-daemon-launch-helper ] && \
    chgrp messagebus /usr/lib/dbus-1.0/dbus-daemon-launch-helper 2>/dev/null || true
  [ -e /usr/lib/x86_64-linux-gnu/utempter/utempter ] && \
    chgrp utmp /usr/lib/x86_64-linux-gnu/utempter/utempter 2>/dev/null || true
}

# --- 1. Proprietà dei file di sistema --------------------------------------
# Directory che devono essere di root. NON tocchiamo /home, /tmp, /var/spool,
# /var/mail, /run, /dev: lì un proprietario non-root è legittimo.
SYSTEM_DIRS="/usr /bin /sbin /lib /lib64 /lib32 /libx32 /etc /boot /opt \
/var/lib/dpkg /var/lib/apt /var/cache/apt /var/lib/systemd /var/lib/polkit-1"

bad="$(find /usr /etc /var/lib/dpkg -xdev ! -uid 0 -print -quit 2>/dev/null || true)"
if [ -n "$bad" ]; then
  echo "==> Proprietà errata nel sistema ($bad): ripristino root:root"
  for d in $SYSTEM_DIRS; do
    [ -e "$d" ] && { chown -R 0:0 "$d" 2>/dev/null || true; }
  done
fi

# --- 2. Bit setuid/setgid: sempre ------------------------------------------
# Idempotente e istantaneo; senza questo `sudo` parte e rifiuta di eseguire.
restore_privileged_bits

# --- 3. apt: le directory di _apt ------------------------------------------
# L'utente _apt deve poter scrivere qui (è la causa di
# "apt: open (13: Permission denied)" quando appartengono a uid 1000).
for d in /var/lib/apt/lists /var/cache/apt/archives; do
  [ -d "$d" ] || continue
  chown 0:0 "$d" 2>/dev/null || true
  chmod 0755 "$d" 2>/dev/null || true
done
for d in /var/lib/apt/lists/partial /var/cache/apt/archives/partial; do
  [ -d "$d" ] || continue
  if id _apt >/dev/null 2>&1; then
    chown -R _apt:root "$d" 2>/dev/null || true
  else
    chown -R 0:0 "$d" 2>/dev/null || true
  fi
  chmod 0700 "$d" 2>/dev/null || true
done

# --- 4. Home dell'utente live ----------------------------------------------
if id user >/dev/null 2>&1; then
  _ug="$(id -gn user)"
  install -d -m 0755 -o user -g "$_ug" /home/user
  chown -R user:"$_ug" /home/user 2>/dev/null || true
  chmod -R u+rwX,go+rX /home/user 2>/dev/null || true
  for f in /etc/skel/.bashrc /etc/skel/.profile /etc/skel/.bash_logout; do
    [ -f "$f" ] || continue
    [ -e "/home/user/$(basename "$f")" ] || cp -a "$f" /home/user/ 2>/dev/null || true
  done
fi

# --- 5. Verifica bloccante -------------------------------------------------
for f in /usr/bin/sudo /usr/bin/systemctl /usr/bin/apt /usr/bin/dpkg \
         /usr/bin/passwd /bin/sh /usr/bin/dash; do
  if [ ! -e "$f" ]; then
    error "manca $f"
    continue
  fi
  uid="$(stat -c %u "$f")"
  [ "$uid" = "0" ] || error "$f appartiene a uid $uid (deve essere 0: altrimenti sudo/apt si rompono)"
done

if [ -e /usr/bin/sudo ] && [ ! -u /usr/bin/sudo ]; then
  error "/usr/bin/sudo non ha il bit setuid (impossibile ripristinarlo)"
fi

rebo=""
for f in /sbin/reboot /usr/sbin/reboot /bin/systemctl /usr/bin/systemctl; do
  [ -e "$f" ] && rebo="$f" && break
done
[ -n "$rebo" ] || error "nessun comando di riavvio (/sbin/reboot o systemctl)"

for d in /var/lib/apt/lists /var/cache/apt/archives /var/lib/dpkg; do
  [ -d "$d" ] || continue
  uid="$(stat -c %u "$d")"
  [ "$uid" = "0" ] || error "$d appartiene a uid $uid (apt fallirebbe con 'open (13: Permission denied)')"
done

for d in /var/lib/apt/lists/partial /var/cache/apt/archives/partial; do
  [ -d "$d" ] || continue
  m="$(stat -c %a "$d")"
  [ "$m" = "700" ] || error "$d ha modo $m (atteso 700)"
done

if id user >/dev/null 2>&1 && [ -d /home/user ]; then
  _uid="$(id -u user)"
  _home_uid="$(stat -c %u /home/user)"
  [ "$_home_uid" = "$_uid" ] || \
    error "/home/user appartiene a uid $_home_uid invece che a user ($_uid)"
fi

if [ "$fail" = "1" ]; then
  echo "VERIFICA FALLITA: il sistema costruito non è utilizzabile." >&2
  echo "                 Rimedi: rm -rf cache/chroot e ricostruisci (cache del chroot corrotto)." >&2
  exit 1
fi

echo "Verifica sistema: OK (sudo setuid+root, apt/_apt, /home/user, riavvio)"
