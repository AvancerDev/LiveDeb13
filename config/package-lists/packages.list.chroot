# ZinimalOS — pacchetti del sistema LIVE (chroot)
# Un pacchetto per riga. Le righe che iniziano con # sono commenti.
# Vedi: https://wiki.debian.org/Live/Build/Customization

# --- Core live ---
live-boot
live-config
live-tools

# --- Init & kernel ---
systemd
systemd-sysv
linux-image-amd64

# --- Firmware & microcode ---
firmware-linux
firmware-linux-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-b43-installer
intel-microcode
amd64-microcode

# --- Bootloader & installer ---
# NOTA: il Debian Installer non si installa come pacchetto nel chroot:
# live-build lo scarica dal mirror (--debian-installer live).
grub-efi-amd64-bin
grub-efi-amd64-signed
grub-pc-bin
grub2-common
shim-signed
syslinux
isolinux
extlinux
memtest86+
os-prober
efibootmgr

# --- Base system ---
base-files
bash
bash-completion
coreutils
sudo
ca-certificates
locales
console-setup
keyboard-configuration
tzdata
less
man-db
nano
vim-tiny
curl
wget
htop
tmux
screen
mc
openssh-server
openssh-client
rsync
tree
file
psmisc
procps
iproute2
iputils-ping
bind9-dnsutils
net-tools
strace
lsof
pciutils
usbutils
smartmontools
hdparm
nvme-cli
parted
gdisk
dosfstools
exfatprogs
btrfs-progs
xfsprogs
ntfs-3g
cryptsetup
lvm2
mdadm

# --- Rete (Wi-Fi + Ethernet) ---
network-manager
network-manager-openvpn
iwd
wpasupplicant
wireless-regdb

# --- Info di sistema / branding ---
# fastfetch: logo del sistema + info di sistema, eseguito a mano `fastfetch`
# (config: config/includes.chroot/etc/fastfetch/config.jsonc)
fastfetch

# --- Utilità live / rescue ---
# Nomi dei pacchetti come in Debian (non Ubuntu): gdisk (non gptfdisk),
# bind9-dnsutils (non dnsutils). Niente GUI (gparted) né clonezilla
# (server edition, trascina drbl/python3): la live è solo console.
testdisk
gddrescue
partclone
squashfs-tools
xorriso
mtools
