#!/bin/bash
# LiveDeb13 — configurazione live-build per Debian 13 (trixie) amd64
# Vedi: https://wiki.debian.org/Live/Build/GettingStarted
#       https://manpages.debian.org/trixie/live-build/lb_config.1.en.html
#
# NOTA 1 — opzioni rimosse in live-build 4.x:
#   --hostname, --username, --locale, --keyboard-layout, --timezone,
#   --language, --user-password, --root-password non esistono più.
#   Hostname/utente/locale si impostano con:
#     - --bootappend-live (parametri kernel live-config)
#     - config/includes.chroot/etc/hostname
#     - config/hooks/ (locale, utente)
#     - config/preseed/preseed.cfg (installer)
#
# NOTA 2 — compatibilità tra versioni di live-build:
#   il set di opzioni accettate da `lb config` cambia da versione a versione.
#   Questo script interroga `lb config --help` e passa SOLO le opzioni
#   supportate dall'istanza di live-build installata (le altre vengono
#   saltate con un avviso), così la configurazione non si rompe con
#   "opzione non riconosciuta".
#
# NOTA 3 — APT / security (trixie):
#   live-build genera da sé le righe di /etc/apt/sources.list a partire dai
#   mirror impostati. Per "trixie" alcune versioni usano ancora il vecchio
#   schema Debian (<dist>/updates) per il repository di sicurezza, producendo
#   una riga non valida del tipo
#       deb http://security.debian.org/ trixie/updates main
#   che fa fallire 'apt update' con:
#       E: The repository 'http://security.debian.org trixie/updates Release'
#          does not have a Release file.
#   Per evitarlo disattiviamo la generazione automatica (--security false) e
#   forniamo noi il repository corretto tramite
#       config/archives/livedeb13-security.list
#   (usato sia nel chroot di build sia nel sistema live).
#   Riferimento: Debian 13 usa deb.debian.org/debian per trixie/trixie-updates
#   e security.debian.org/debian-security per la suite trixie-security.
set -e

cd "$(dirname "$0")/.."

# --- Controllo versione live-build -------------------------------------------
# live-build 2.x/3.x (es. "3.0~a57", epoca Debian 7/8) NON può costruire
# immagini Debian 13: usa ancora aufs, --force-yes, sorgenti APT vecchio stile
# e non supporta molte opzioni. Va sostituita con quella di trixie.
LB_VERSION_LINE="$(lb --version 2>/dev/null | head -n 1)"
LB_VERSION="${LB_VERSION_LINE#live-build }"
LB_VERSION_NOVERSION="${LB_VERSION##*:}"   # rimuove un eventuale epoch "1:"
case "${LB_VERSION_NOVERSION}" in
  2.*|3.*)
    cat >&2 <<'AVVISO'

ERRORE: la live-build installata e' troppo vecchia per costruire Debian 13.

  Versione rilevata: serie 2.x/3.x (epoca Debian 7/8: aufs, --force-yes,
  opzioni --image-name/--bootloaders/--updates assenti).
  Tipico di Ubuntu, che impacchetta live-build 3.0~a57-1ubuntuXX, e delle
  installazioni manuali in /usr/local/bin.

Tre modi per risolvere (consigliato il primo):

A) Build in un container Debian 13 (non tocca il sistema host, ambiente
   identico alla CI). Serve docker o podman:

     ./build-docker.sh          # oppure: make docker
     # con pulizia preventiva: ./build-docker.sh --clean

B) Build su GitHub Actions (nessuna installazione locale):
   tab "Actions" -> "Build LiveDeb13 ISO" -> "Run workflow" sulla tua branch,
   poi scarica l'artifact "livedeb13-amd64-<branch>" (contiene la ISO).

C) Installare la live-build di Debian sul sistema (Ubuntu: miscela non
   supportata, ma e' solo shell + debootstrap):

     sudo apt purge live-build
     cd /tmp
     wget http://deb.debian.org/debian/pool/main/l/live-build/live-build_20250505+deb13u1_all.deb
     sudo apt install ./live-build_20250505+deb13u1_all.deb
     hash -r
     lb --version               # deve mostrare 20250505+deb13u1

Dettagli: docs/BUILD.md sezioni 1, 6.3 e 8.

AVVISO
    echo "Versione rilevata: ${LB_VERSION_LINE}"
    exit 1
    ;;
esac
# -----------------------------------------------------------------------------

# Rimuove i file di configurazione salvati da un'esecuzione precedente di
# `lb config` (vedi lb_config(1): vanno eliminati prima di rigenerare,
# altrimenti valori vecchi possono restare "congelati" nella configurazione).
# Le nostre directory (package-lists/, hooks/, includes.chroot/, archives/, ...)
# non vengono toccate.
rm -f config/binary config/bootstrap config/chroot config/common config/source config/image

# Mirror configurabili senza modificare lo script, es.:
#   sudo env DEBIAN_MIRROR=http://ftp.it.debian.org/debian/ make build
MIRROR="${DEBIAN_MIRROR:-http://deb.debian.org/debian/}"
SECURITY_MIRROR="${DEBIAN_SECURITY_MIRROR:-http://security.debian.org/debian-security/}"

# Coppie "opzione valore" (tutte le opzioni usate qui richiedono un valore).
ARGS=(
  --distribution trixie
  --parent-distribution trixie
  --archive-areas "main contrib non-free non-free-firmware"
  --mirror-bootstrap "${MIRROR}"
  --mirror-chroot "${MIRROR}"
  --mirror-binary "${MIRROR}"
  --mirror-chroot-security "${SECURITY_MIRROR}"
  --mirror-binary-security "${SECURITY_MIRROR}"
  --mirror-debian-installer "${MIRROR}"
  --architecture amd64
  --mode debian
  --system live
  --initsystem systemd
  --linux-packages linux-image
  --linux-flavours amd64
  --initramfs live-boot
  --compression xz
  --binary-image iso-hybrid
  --image-name livedeb13
  --iso-volume LiveDeb13
  --iso-application "Debian 13 Live Installer"
  --iso-publisher LiveDeb13
  --debian-installer live
  --debian-installer-distribution trixie
  --debian-installer-gui false
  --memtest memtest86+
  --firmware-chroot true
  --firmware-binary true
  --security false
  --backports false
  --apt-source-archives false
  --apt-indices true
  --apt-options "--option Acquire::Retries=3 --option Acquire::http::Timeout=30"
  --keyring-packages debian-archive-keyring
  --cache "${CACHE:-true}"
  --chroot-filesystem squashfs
  --binary-filesystem fat32
  --bootappend-live "boot=live components hostname=livedeb13 username=user user-fullname=Live_User locales=it_IT.UTF-8 keyboard-layouts=it timezone=Europe/Rome"
)

# Elenco delle opzioni supportate da questa live-build (dall'help di `lb config`).
LB_HELP="$(lb config --help 2>&1 || true)"

# supported <opzione> → vero se l'opzione compare nell'help.
supported() {
  [ -n "${LB_HELP}" ] || return 0        # help non disponibile: non filtrare
  printf '%s\n' "${LB_HELP}" | grep -qE -- "$1([[:space:]=]|$)"
}

FILTERED=()
SKIPPED=()
i=0
while [ "${i}" -lt "${#ARGS[@]}" ]; do
  OPT="${ARGS[$i]}"
  VAL="${ARGS[$((i + 1))]}"
  if supported "${OPT}"; then
    FILTERED+=("${OPT}" "${VAL}")
  else
    SKIPPED+=("${OPT}")
  fi
  i=$((i + 2))
done

if [ "${#SKIPPED[@]}" -gt 0 ]; then
  echo "ATTENZIONE: opzioni non supportate da questa versione di live-build, ignorate:"
  echo "  ${SKIPPED[*]}"
  echo "  (l'ISO userà i valori predefiniti per queste opzioni; vedi docs/BUILD.md)"
fi

lb config noauto "${FILTERED[@]}" "$@"
