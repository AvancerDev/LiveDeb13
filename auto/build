#!/bin/sh
# ZinimalOS — build dell'ISO (richiede root)
#
# Comportamento:
# 1) Se la live-build dell'host manca o è troppo vecchia (serie 2.x/3.x, tipica
#    di Ubuntu) e docker/podman è disponibile, la build viene eseguita
#    automaticamente in un container Debian 13 (build-docker.sh).
# 2) Rimuoviamo lo stage file `.build/config` prima di `lb build`: così
#    live-build riesegue sempre auto/config.
# 3) Se live-build non supporta --image-name, il nome dell'ISO è quello
#    predefinito (live-image-amd64.hybrid.iso): la rinominiamo comunque in
#    zinimalos-amd64.hybrid.iso, che è il nome atteso da Makefile e docs.
set -e

lb_version_ok() {
  command -v lb >/dev/null 2>&1 || return 1
  _v="$(lb --version 2>/dev/null | head -n 1)"
  _v="${_v#live-build }"
  _v="${_v##*:}"                     # rimuove un eventuale epoch "1:"
  case "${_v}" in
    2.*|3.*|"") return 1 ;;          # live-build di Debian 7/8: inutilizzabile
  esac
  return 0
}

# --- Delegazione automatica al container Debian 13 ---------------------------
if [ "${ZINIMALOS_IN_CONTAINER:-0}" != "1" ] && ! lb_version_ok; then
  if [ -x ./build-docker.sh ] && { command -v docker >/dev/null 2>&1 || command -v podman >/dev/null 2>&1; }; then
    echo "==> live-build dell'host assente o troppo vecchia (serie 2.x/3.x)."
    echo "==> Eseguo la build in un container Debian 13 (build-docker.sh)..."
    exec ./build-docker.sh "$@"
  fi
  echo "ERRORE: impossibile compilare con la live-build dell'host (troppo vecchia)." >&2
  echo "        Installa docker/podman e usa ./build-docker.sh, oppure vedi" >&2
  echo "        docs/BUILD.md §8 (container / GitHub Actions / live-build di Debian)." >&2
  exit 1
fi
# -----------------------------------------------------------------------------

rm -f .build/config

# --- Pacchetto di branding (logo, /etc/issue, MOTD, config fastfetch, script) --
# Questi file NON vengono più copiati da config/includes.chroot/: arrivano al
# chroot solo tramite il pacchetto .deb (hook 0400-install-branding-deb).
# Va quindi ricostruito a ogni build, così l'ISO contiene la versione corrente
# — la stessa che le macchine installate scaricano con `apt upgrade`.
if [ -x ./packaging/build-deb.sh ] && command -v dpkg-deb >/dev/null 2>&1; then
  echo "==> Costruisco il pacchetto zinimalos-branding (.deb)"
  ./packaging/build-deb.sh >/dev/null
fi

# --- Invalidazione automatica degli stadi quando la configurazione cambia -----
# live-build salta ogni stadio che ha già il suo "stage file" in .build/ (il
# nome è quello dello script: chroot_hooks, binary_rootfs, …). Di conseguenza
# una modifica a config/includes.chroot/ (logo, motd, .bashrc…) NON entrerebbe
# mai nella ISO: la build finirebbe identica alla precedente.
# Qui, se qualche file di configurazione è più recente dell'ultima build,
# togliamo gli stage file di chroot e binary: gli stadi vengono rieseguiti sul
# chroot esistente (nessun riscaricamento) e la modifica finisce nell'immagine.
if [ -d .build ]; then
  NEWEST_STAGE="$(ls -t .build/* 2>/dev/null | grep -v '/config$' | grep -v '/lock$' | head -1 || true)"
  if [ -n "${NEWEST_STAGE}" ]; then
    CHANGED=0
    for d in branding config/includes.chroot config/includes.binary \
             config/package-lists config/hooks config/preseed config/archives \
             config/bootloaders; do
      [ -e "${d}" ] || continue
      # config/includes.chroot/opt/zinimalos/packages è generato da
      # packaging/build-deb.sh a ogni build: se lo contassimo, ogni build
      # sembrerebbe "configurazione modificata" e rifarebbe tutto il chroot.
      if [ -n "$(find "${d}" -path 'config/includes.chroot/opt' -prune -o \
                 -newer "${NEWEST_STAGE}" -print -quit 2>/dev/null)" ]; then
        CHANGED=1
        break
      fi
    done
    if [ "${CHANGED}" = "1" ]; then
      echo "==> Configurazione più recente dell'ultima build: rieseguo chroot + binary"
      echo "    (nessun pacchetto riscaricato: chroot/ e cache/ restano)"
      rm -f .build/chroot_* .build/binary_* .build/binary
    fi
  fi
fi

# --- Proprietà dei file nel chroot --------------------------------------------
# Se in chroot/ ci sono file che non appartengono a root (tipico dopo un
# `chown -R utente` fatto per sbloccare git, o dopo una build interrotta), la
# ISO che ne deriva è ROTTA in modo silenzioso:
#   sudo: /usr/bin/sudo is owned by uid 1000, should be 0   (sudo non parte)
#   apt:  open (13: Permission denied)                      (cache non scrivibile)
# Qui li riportiamo a root:root prima di costruire.
if [ -d chroot ] && [ "$(id -u)" = "0" ]; then
  for _d in chroot cache; do
    [ -d "$_d" ] || continue
    if [ -n "$(find "$_d" -xdev ! -uid 0 -print -quit 2>/dev/null)" ]; then
      echo "==> File non di root in ${_d}/: ripristino root:root (la ISO sarebbe rotta)"
      chown -R 0:0 "$_d" || true
    fi
  done
fi

if ! lb build noauto "$@"; then
  cat >&2 <<'EOF'

================= BUILD FALLITA =================
Suggerimenti rapidi (dettagli in docs/BUILD.md §6):

1) Stato sporco (build precedente interrotta): è la causa più frequente.
   Reset veloce, SENZA riscaricare i pacchetti:
     ./build-docker.sh --reset
   Pulizia totale (riscarica ~1,5 GB), solo se il reset non basta:
     sudo rm -rf chroot binary cache .build

2) Errori tipo "gzip: stdin: unexpected end of file" (file scaricati
   troncati / cache corrotta) → riscarica tutto senza cache:
     sudo env CACHE=false make build

3) Mirror alternativo (es. italiano):
     sudo env DEBIAN_MIRROR=http://ftp.it.debian.org/debian/ make build

4) Log completo (qui dentro: /build/build.log, cioè build.log nella radice):
     tail -n 40 build.log
=================================================
EOF
  exit 1
fi

for f in live-image-amd64.hybrid.iso ./*.hybrid.iso; do
  [ -f "$f" ] || continue
  case "$f" in
    ./zinimalos-amd64.hybrid.iso|zinimalos-amd64.hybrid.iso) ;;
    *) mv -f "$f" zinimalos-amd64.hybrid.iso ;;
  esac
done

if [ -f zinimalos-amd64.hybrid.iso ]; then
  echo "==> ISO: zinimalos-amd64.hybrid.iso"
fi
